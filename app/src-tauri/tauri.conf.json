{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assieme",
  "version": "0.1.0",
  "identifier": "dev.assieme.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/bundle.sh --refresh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Assieme",
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "visible": false
      },
      {
        "label": "menu",
        "url": "index.html?menu",
        "title": "Assieme menu",
        "width": 360,
        "height": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python/": "python/",
      "resources/hc/": "hc/",
      "resources/hc-bin/": "hc-bin/",
      "../NOTICE": "NOTICE"
    }
  }
}